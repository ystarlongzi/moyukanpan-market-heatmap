# 域名和证书路径为示例，部署前替换为实际值。
server {
    listen 80;
    listen [::]:80;
    server_name heatmap.moyukanpan.com;
    return 301 https://heatmap.moyukanpan.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name heatmap.moyukanpan.com;

    ssl_certificate /etc/letsencrypt/live/heatmap.moyukanpan.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/heatmap.moyukanpan.com/privkey.pem;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 75s;

    location = /api/heatmap/quotes/stream {
        proxy_buffering off;
        proxy_pass http://127.0.0.1:3215;
    }

    location / {
        proxy_pass http://127.0.0.1:3215;
    }
}
